# 사이트별 값(경로·토큰). 이 파일을 site.env 로 복사해서 실제값을 채운다:
#   cp site.env.example site.env
#
# site.env 는 gitignore 되어 있다. 이름이 점(.)으로 시작하지 않는 이유: 서버에는 git
# 없이 deploy_vlms/ 와 flask_api/ 폴더를 복사해 올리는데, 숨김 파일은 그때 빠지기 쉽다.
# serve_vlm.py(start_*.py 가 부른다)와 flask_api(import 시점)가 이 파일을 스스로 읽는다.
# 셸에 이미 export 된 키는 그쪽이 우선한다. 경로는 SITE_ENV 로 바꿀 수 있다.

# ── 사내 경로 ────────────────────────────────────────────────────────────
# 모델 체크포인트가 모여 있는 디렉토리.
# models/*.env 의 MODEL_ID 와 common.env 의 ALLOWED_MODEL_ROOT 가 ${MODEL_ROOT} 로
# 이 값을 참조한다. 여기만 채우면 모델 설정이 전부 맞는다.
MODEL_ROOT=/path/to/models

# ── Flask 프록시 ─────────────────────────────────────────────────────────
# vLLM 이 떠 있는 호스트. Flask 를 같은 GPU 서버에서 돌리면 기본값 그대로 둔다.
VLM_SERVE_UPSTREAM_HOST=127.0.0.1

# 업로드 목적지 루트. Flask 프로세스는 common.env 를 읽지 않으므로
# ALLOWED_MODEL_ROOT 로 흘러가지 않는다 - 여기서 명시해야 한다.
MODEL_UPLOAD_ROOT=${MODEL_ROOT}

# ── 시크릿 ───────────────────────────────────────────────────────────────
# 업스트림 vLLM 에 Authorization: Bearer 로 붙는다.
# config/common.env 의 API_KEY 를 설정한 경우에만 채운다.
VLM_SERVE_UPSTREAM_API_KEY=

# /api/model_upload 인증 토큰. 비우면 인증 없이 업로드가 열린다.
MODEL_UPLOAD_TOKEN=

# 팀 공용 프록시 토큰. 설정하면 /api/vlm_serve/<slug>/v1/* 호출에 요구된다.
# home / health 는 인증 없이 열려 있다 (모니터링용).
# 비우면 인증이 꺼진다 - 기존 배포가 조용히 막히지 않도록 한 규약.
# 호출자는 X-VLM-Token 또는 Authorization: Bearer 둘 다 쓸 수 있다
# (OpenAI 클라이언트의 api_key 가 후자로 나간다).
VLM_SERVE_TOKEN=
