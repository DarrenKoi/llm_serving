# Bind on every interface so teammates and coding harnesses (opencode, pi) reach vLLM directly.
#
# NOT the specific internal IP, even though that is what you usually want to hear: start_all.py's
# readiness poll (line ~186), check_vlm.py's default, and the Flask proxy's VLM_SERVE_UPSTREAM_HOST
# all dial 127.0.0.1. Binding a single NIC silently removes the loopback path all three depend on,
# and start_all.py's failure mode is to stop each model it cannot reach — the whole bring-up dies.
# 0.0.0.0 is a superset: it covers the internal IP *and* loopback.
#
# Restricting *who* may reach the port is a firewall/security-group rule — that is the layer that
# actually enforces it. API_KEY below is the second gate.
HOST=0.0.0.0

DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
TENSOR_PARALLEL_SIZE=1

# For 2-3 small models on one GPU, enable AUTO_TUNE per model env
# (keep commented here — each model/*.env activates it as needed).
# AUTO_TUNE_GPU_MEMORY_UTILIZATION=1
# COLOCATED_MODELS_PER_GPU=2
GPU_TOTAL_MEMORY_GIB=140
GPU_SHARED_RESERVE_GIB=8
GPU_PROCESS_RESERVE_GIB=4

# Upstream auth, required now that HOST is no longer loopback-only.
# The value lives in exactly ONE place — site.env's VLM_SERVE_UPSTREAM_API_KEY — and is pulled in
# here by ${} expansion. Two reasons it is not written literally: this repo is public, and the Flask
# proxy sends the same key upstream (VLM_SERVE_UPSTREAM_API_KEY), so a second copy is a 401 waiting
# to drift. Empty, or site.env left unfilled, means auth is off.
API_KEY=${VLM_SERVE_UPSTREAM_API_KEY}

# Security/offline controls
STRICT_OFFLINE=1
DISABLE_OUTBOUND_PROXIES=1
CREATE_VLLM_DO_NOT_TRACK_FILE=1
ALLOWED_MODEL_ROOT=${MODEL_ROOT}
