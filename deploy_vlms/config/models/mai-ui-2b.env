# MAI-UI-2B - 8B 대체 후보. 상시 기동이 아니라 **A/B 벤치용**이다 (2026-09-03).
#
# 왜 있나: 호스트 RAM 16GB 압박 때문에 grounding 모델을 2B 로 내릴 수 있는지 재려는 것.
# 공개 수치는 ScreenSpot-Pro 기준 8B 65.7% vs 2B 57.4% 인데, 2B 는 zoom-in 전략을 쓰면
# 62.8% 로 올라간다. 이 저장소의 로케이터가 바로 그 2단(coarse bbox -> 확대 crop 에서
# fine point) 구조라, 발표된 격차보다 실제 격차가 작을 가능성이 있다. 그래서 재본다.
# (8B+zoom 수치는 발표된 적이 없으므로 '격차가 좁혀진다'는 것은 가설이지 결론이 아니다.)
#
# 벤치는 두 모델이 **동시에** 떠 있어야 한다. bench_tool_locator 가 프레임을 한 번만
# 캡처해 모든 조합에 같은 화면을 보여주기 때문이다 (그게 A/B 의 핵심이라 순차 실행으로
# 대체할 수 없다 - 화면 드리프트가 모델 차이로 둔갑한다).
# 16GB 호스트에 4번째 인스턴스를 올리지 말 것. 벤치 동안 qwen3.8-27b 를 내렸다가
# 끝나고 되돌린다 (docs 의 A/B 절차 참고).
MODEL_ID=${MODEL_ROOT}/MAI-UI-2B
SERVED_MODEL_NAME=mai-ui-2b
PORT=8007
GPU_ID=0
TRUST_REMOTE_CODE=1
LIMIT_MM_PER_PROMPT={"image": 1}
CHAT_TEMPLATE=
# 2B 라 가중치 ~4GiB. 8B(0.45) + paddleocr(0.20) 와 같은 GPU 0 을 쓰므로 작게 잡는다.
# 셋을 더해 0.80 -> GPU 0 에 28GiB 여유.
GPU_MEMORY_UTILIZATION=0.15
# 8B 와 **동일하게** 맞춘다. 비교 대상이 모델 크기 하나여야 하므로 여기를 다르게 두면 안 된다.
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384
# 호스트 RAM 16GB 방어 (mai-ui.env 주석과 같은 이유).
EXTRA_VLLM_ARGS=--load-format safetensors --safetensors-load-strategy lazy --mm-processor-cache-gb 0
