MODEL_ID=/path/to/models/MAI-UI-8B
SERVED_MODEL_NAME=mai-ui-8b
PORT=8002
GPU_ID=0
TRUST_REMOTE_CODE=1
LIMIT_MM_PER_PROMPT={"image": 1}
CHAT_TEMPLATE=
# 2026-09-03: paddleocr-vl-1.5 가 GPU 1 에서 넘어와 GPU 0 을 공유한다
# (GPU 1 은 Qwen3.8-27B 단독 점유). 그래서 0.85 -> 0.45 로 내린다.
# 실제 소요는 8B bf16 가중치 16GiB + KV(16384 x 16 = 262k 토큰 x 56KiB) 14GiB = ~30GiB 라
# 0.45(63GiB)로도 두 배 여유다. 0.85 는 애초에 대부분 안 쓰는 KV 풀이었다.
# AUTO_TUNE 은 켜지 않는다 - share 규칙(0.5 씩 반띵)보다 이 명시값이 실제에 가깝다.
GPU_MEMORY_UTILIZATION=0.45
# Grounding calls are latency-bound (2-stage locator = 2 sequential calls),
# so the levers that matter are prefill headroom, not batch size.
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384
# 호스트 RAM 16GB 제약: 아래 값은 GPU 가 아니라 시스템 메모리를 쓴다.
#   --mm-processor-cache-gb (기본 4GiB, host) : 디코딩된 이미지 캐시 상한.
#     스크린샷은 매번 다르므로 캐시 적중이 거의 없다 -> 0 으로 끈다.
# --swap-space 는 넣지 말 것: 이 서버의 vLLM 은 해당 인자를 없앴다
# (V1 엔진이 preemption 을 recompute 로 처리하면서 CPU KV swap 자체가 사라짐).
# 2026-08-11 오피스 실측: api_server.py "unrecognized arguments: --swap-space" 로 기동 실패.
# --load-format safetensors --safetensors-load-strategy lazy : 호스트 RAM 16GB 방어.
#   lazy=mmap 이라 가중치를 익명 메모리로 복사하지 않는다. 명시하는 이유는 기본값이 NFS 에서
#   '체크포인트 <= 가용 RAM 90%' 면 자동 prefetch 로 새기 때문 - 작은 모델일수록 그 조건에
#   걸린다. 3개 인스턴스가 16GB 를 나눠 쓰므로 추측에 맡기지 않는다.
EXTRA_VLLM_ARGS=--load-format safetensors --safetensors-load-strategy lazy --mm-processor-cache-gb 0
