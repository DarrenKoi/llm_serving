MODEL_ID=${MODEL_ROOT}/PaddleOCR-VL-1.5
SERVED_MODEL_NAME=paddleocr-vl-1.5
PORT=8004
GPU_ID=0
TRUST_REMOTE_CODE=1
LIMIT_MM_PER_PROMPT={"image": 1}
CHAT_TEMPLATE=
# Tiny 0.9B model. 2026-09-03: GPU 1 -> GPU 0, mai-ui 옆으로 이사.
# GPU 1 을 Qwen3.8-27B 단독 점유로 비우기 위한 것이다. 0.9B 라 u=0.20(28GiB) 도
# 이미 과분하지만, mai-ui(0.45) 와 합쳐도 0.65 라 GPU 0 에 49GiB 가 남는다.
# AUTO_TUNE 은 켜지 않는다 - 두 모델 모두 실제 소요가 share 규칙보다 훨씬 작아
# 명시값이 더 정확하다.
GPU_MEMORY_UTILIZATION=0.20
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
# 호스트 RAM 16GB 제약 (mai-ui.env 주석 참고). --swap-space 는 이 vLLM 에 없다.
# --load-format safetensors --safetensors-load-strategy lazy : 호스트 RAM 16GB 방어.
#   lazy=mmap 이라 가중치를 익명 메모리로 복사하지 않는다. 명시하는 이유는 기본값이 NFS 에서
#   '체크포인트 <= 가용 RAM 90%' 면 자동 prefetch 로 새기 때문 - 작은 모델일수록 그 조건에
#   걸린다. 3개 인스턴스가 16GB 를 나눠 쓰므로 추측에 맡기지 않는다.
EXTRA_VLLM_ARGS=--load-format safetensors --safetensors-load-strategy lazy --mm-processor-cache-gb 0
