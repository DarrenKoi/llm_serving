# Copy to .env and fill in. Nothing auto-loads this file — export it yourself
# before starting the Flask app:  set -a; . ./.env; set +a
#
# Secrets only. Tuning knobs live in deploy_vlms/config/*.env (see README).

# Sent as `Authorization: Bearer` to the upstream vLLM server.
# Leave empty unless config/common.env sets API_KEY.
VLM_SERVE_UPSTREAM_API_KEY=

# Required to authenticate /api/model_upload requests.
# Empty = uploads accept any caller.
MODEL_UPLOAD_TOKEN=
